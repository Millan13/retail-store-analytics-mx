# Copia este archivo a .env y completa lo que aplique. .env está en .gitignore.

# Opcional: origen de los datos crudos. Si no se define, se usa data/raw (config.yaml).
# RAW_DATA_URI=gs://mi-bucket/retail/raw

# Opcional: credenciales de servicio de GCP para leer gs:// (requiere `uv sync --extra gcs`).
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/fuera/del/repo/service-account.json
